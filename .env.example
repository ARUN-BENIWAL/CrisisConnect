# ==============================================================================
# CrisisConnect Environment Configuration Template
# Copy this file to .env or set variables in your deployment environment.
# DO NOT commit real secrets, private keys, or passwords to source control.
# ==============================================================================

# Backend Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (for 'prod' / MySQL profile)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/crisisconnect?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=crisis_user
SPRING_DATASOURCE_PASSWORD=your_secure_database_password

# Security & Authentication (Change in production)
JWT_SECRET=crisisconnect_secret_key_minimum_256_bits_for_production_security_compliance
JWT_EXPIRATION_MS=86400000

# Frontend Client Configuration
# Default '/api' uses Vite dev proxy to http://localhost:8080
VITE_API_URL=/api
